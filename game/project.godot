; Mustache Massacre: Last Call — Godot 4.7.2
config_version=5

[application]
config/name="Mustache Massacre — Last Call"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/description="The apocalypse has never been this well-groomed."
config/version="0.4.0"
config/icon="res://icon.svg"

[autoload]
Preferences="*res://scripts/preferences.gd"
Sound="*res://scripts/sound.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[editor]
import/use_multiple_threads=false
export/convert_text_resources_to_binary=false

[rendering]
renderer/rendering_method="forward_plus"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.14,0.11,0.09,1)

[physics]
common/physics_ticks_per_second=60

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemies"
3d_physics/layer_4="Destructible"

[audio]
default_bus_layout="res://default_bus_layout.tres"
